PROGRAM ACTUATOR_2P_sfc_iter_01
  VAR
    IN : BYTE;
    TEST : BOOL;
    ARE : BOOL;
    CYCLE_TIME : TIME;
    SENS : BYTE;
    SELF_ACT_TIME : TIME;
    SELF_ACT_PULSE : BOOL;
    SELF_ACT_CYCLES : BOOL;
    OUT : BOOL;
    ARO : BOOL;
    ARX : BOOL;
    timer : TIME;
    pwgen : BOOL;
    INPUT_VALID : BOOL;
    SAFETY_ERROR_FLAG : BOOL;
    SAFETY_ERROR_CODE : UINT;
    CUMULATIVE_CYCLE_TIME : TIME;
    MAX_SAFE_CYCLE_TIME : TIME;
    TIMEOUT_EXCEEDED : TIME;
    TIMEOUT_ERROR_FLAG : TIME;
    TIMEOUT_LOG_TIME : TIME;
  END_VAR

  STEP InitCycle INITIAL ACTION timer(trun := MUL_T_AI(SELF_ACT_PULSE,2 * SELF_ACT_CYCLES), toff := SELF_ACT_TIME, Test := TEST, ARE := ARE, arx := ARX); ARX := timer.ARX; ARO := timer.ARO;;
  STEP SafetyCheckInput ACTION INPUT_VALID := (IN >= BYTE#0) AND (IN <= BYTE#255) AND (SENS > BYTE#0) AND (SENS <= BYTE#255); CUMULATIVE_CYCLE_TIME := CUMULATIVE_CYCLE_TIME + CYCLE_TIME;;
  STEP SafetyError ACTION out := FALSE; SAFETY_ERROR_FLAG := TRUE; SAFETY_ERROR_CODE := UINT#1001;;
  STEP Branch_0 ACTION pwgen(PTL := SELF_ACT_PULSE, PTH := SELF_ACT_PULSE); out := pwgen.Q;;
  STEP Branch_1 ACTION out := FALSE;;
  STEP Branch_2 ACTION out := TRUE;;
  STEP Step_255 ACTION pwgen.PTH := (CYCLE_TIME * BYTE_TO_TIME(BAND_B(IN,SENS)) ) / BYTE_TO_TIME(BYTE#255); pwgen.PTL := CYCLE_TIME - pwgen.PTH; pwgen(); out := pwgen.Q;;
  STEP ApplyOutput ACTION TIMEOUT_EXCEEDED := CUMULATIVE_CYCLE_TIME > MAX_SAFE_CYCLE_TIME;;
  STEP TimeoutSafeStop ACTION out := FALSE; TIMEOUT_ERROR_FLAG := TRUE; TIMEOUT_LOG_TIME := CUMULATIVE_CYCLE_TIME; CUMULATIVE_CYCLE_TIME := T#0s;;

  TRANSITION FROM InitCycle TO SafetyCheckInput CONDITION
    TRUE;

  TRANSITION FROM SafetyCheckInput TO SafetyError CONDITION
    INPUT_VALID = FALSE;

  TRANSITION FROM SafetyCheckInput TO Branch_0 CONDITION
    INPUT_VALID = TRUE AND aro = TRUE;

  TRANSITION FROM SafetyCheckInput TO Branch_1 CONDITION
    INPUT_VALID = TRUE AND aro = FALSE AND in<sens;

  TRANSITION FROM SafetyCheckInput TO Branch_2 CONDITION
    INPUT_VALID = TRUE AND aro = FALSE AND NOT (in<sens) AND BYTE_TO_USINT(in)>USINT#255-BYTE_TO_USINT(sens);

  TRANSITION FROM SafetyCheckInput TO Step_255 CONDITION
    INPUT_VALID = TRUE AND aro = FALSE AND NOT (in<sens) AND NOT (BYTE_TO_USINT(in)>USINT#255-BYTE_TO_USINT(sens));

  TRANSITION FROM Branch_0 TO ApplyOutput CONDITION
    TRUE;

  TRANSITION FROM Branch_1 TO ApplyOutput CONDITION
    TRUE;

  TRANSITION FROM Branch_2 TO ApplyOutput CONDITION
    TRUE;

  TRANSITION FROM Step_255 TO ApplyOutput CONDITION
    TRUE;

  TRANSITION FROM ApplyOutput TO TimeoutSafeStop CONDITION
    TIMEOUT_EXCEEDED = TRUE;

  TRANSITION FROM ApplyOutput TO InitCycle CONDITION
    TIMEOUT_EXCEEDED = FALSE;

  TRANSITION FROM TimeoutSafeStop TO InitCycle CONDITION
    TRUE;

  TRANSITION FROM SafetyError TO SafetyError CONDITION
    TRUE;

END_PROGRAM